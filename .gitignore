# Maintainer instructions, design notes, and reusable editor configuration are
# intentionally trackable in this private single-maintainer repository.

# Environment files may contain credentials; examples remain trackable.
.env
.env.*
!.env.example
!.env.*.example
.envrc

# Local secrets and retired signing material must never enter Git history.
/.echo-local/keys/

# ECHODev is a private development repo, so source files for Pro/cloud can be
# tracked for deploy builds. Keep secrets, generated bundles, databases, and
# runtime artifacts ignored below.

# Keep generated credentials, runtime databases, deploy bundles, and local machine artifacts out of git.
